// FEPForceCalculation.usf - GPU Compute Shader for FEP Force Calculation
// Place this file in: YourProject/Shaders/Private/FEPForceCalculation.usf
// Compatible with Unreal Engine 5.6

#include "/Engine/Public/Platform.ush"

#define THREAD_GROUP_SIZE 64

// ============================================================================
// INPUT BUFFERS (Read-Only)
// ============================================================================

Buffer<float4> Positions;              // (x, y, z, mass) for each atom
Buffer<float> Charges;                 // Partial charges for electrostatics
Buffer<float> VdWRadii;                // Van der Waals radii (sigma)
Buffer<float> VdWEpsilons;             // Van der Waals well depth (epsilon)
Buffer<uint> IsLigandAtom;             // 1 if ligand atom, 0 if protein

// ============================================================================
// OUTPUT BUFFER (Write)
// ============================================================================

RWBuffer<float4> Forces;               // (Fx, Fy, Fz, 0) output forces

// ============================================================================
// SIMULATION PARAMETERS
// ============================================================================

uint NumAtoms;                         // Total number of atoms
float Lambda;                          // FEP coupling parameter (0 to 1)
float CutoffDistance;                  // Interaction cutoff in Angstroms
float CutoffDistanceSq;                // Cutoff squared (optimization)
float DielectricConstant;              // For electrostatic scaling
float CoulombConstant;                 // 332.0636 kcal*A/(mol*e^2)

// ============================================================================
// COMPUTE SHADER KERNEL
// ============================================================================

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void MainCS(uint3 ThreadId : SV_DispatchThreadID)
{
    // Each thread handles one atom
    uint AtomIdx = ThreadId.x;
    
    // Bounds check
    if (AtomIdx >= NumAtoms)
        return;
    
    // Load this atom's properties
    float3 Pos1 = Positions[AtomIdx].xyz;
    float Charge1 = Charges[AtomIdx];
    float Radius1 = VdWRadii[AtomIdx];
    float Epsilon1 = VdWEpsilons[AtomIdx];
    bool bIsLigand1 = (IsLigandAtom[AtomIdx] != 0);
    
    // Accumulate forces from all other atoms
    float3 TotalForce = float3(0.0, 0.0, 0.0);
    
    // Loop over all other atoms
    for (uint j = 0; j < NumAtoms; j++)
    {
        // Skip self-interaction
        if (j == AtomIdx)
            continue;
        
        // Calculate distance
        float3 Pos2 = Positions[j].xyz;
        float3 Delta = Pos2 - Pos1;
        float rSq = dot(Delta, Delta);
        
        // Apply cutoff and minimum distance
        if (rSq >= CutoffDistanceSq || rSq < 0.01)
            continue;
        
        float r = sqrt(rSq);
        float rInv = 1.0 / r;
        
        // Load other atom's properties
        float Charge2 = Charges[j];
        float Radius2 = VdWRadii[j];
        float Epsilon2 = VdWEpsilons[j];
        bool bIsLigand2 = (IsLigandAtom[j] != 0);
        
        // Scale factor for ligand interactions (FEP)
        // If either atom is ligand, scale by Lambda
        float ScaleFactor = (bIsLigand1 || bIsLigand2) ? Lambda : 1.0;
        
        // ===== ELECTROSTATIC FORCE =====
        // Coulomb's law: F = k * q1 * q2 / r^2
        // Force magnitude includes direction (1/r term)
        float ForceMagElec = ScaleFactor * CoulombConstant * Charge1 * Charge2 * 
                            rInv * rInv * rInv / DielectricConstant;
        
        // ===== VAN DER WAALS FORCE =====
        // Lennard-Jones 12-6 potential
        // Combining rules: sigma = (sigma1 + sigma2)/2, epsilon = sqrt(eps1 * eps2)
        float Sigma = (Radius1 + Radius2) * 0.5;
        float Epsilon = sqrt(Epsilon1 * Epsilon2);
        
        // Calculate (sigma/r)^6 and (sigma/r)^12
        float SigmaOverR = Sigma * rInv;
        float SR2 = SigmaOverR * SigmaOverR;
        float SR6 = SR2 * SR2 * SR2;
        float SR12 = SR6 * SR6;
        
        // Force: F = 24*epsilon * [2*(sigma/r)^12 - (sigma/r)^6] / r
        float ForceMagVdW = ScaleFactor * 24.0 * Epsilon * (2.0 * SR12 - SR6) * rInv;
        
        // ===== COMBINE FORCES =====
        float3 Direction = Delta * rInv;  // Unit vector from atom1 to atom2
        float3 Force = Direction * (ForceMagElec + ForceMagVdW);
        
        // Newton's third law: force on atom1 is opposite to force on atom2
        TotalForce -= Force;
    }
    
    // Write final force for this atom
    Forces[AtomIdx] = float4(TotalForce, 0.0);
}

// ============================================================================
// ALTERNATIVE: SHARED MEMORY OPTIMIZATION (Advanced)
// ============================================================================

